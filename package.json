{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --import tsx --watch scripts/dev.ts\" \"vite --port=3000 --host=0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:ui": "vite --port=3000 --host=0.0.0.0",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.98.0",
    "@tailwindcss/vite": "4.2.1",
    "@vitejs/plugin-react": "5.1.4",
    "dotenv": "17.2.3",
    "express": "4.22.3",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "vite": "6.4.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/express": "4.17.21",
    "@types/node": "22.14.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/supertest": "6.0.3",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.4",
    "supertest": "7.1.4",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.8.3"
  },
  "overrides": {
    "tsx": {
      "esbuild": "0.28.2"
    }
  }
