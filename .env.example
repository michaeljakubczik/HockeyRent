SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-key
ADMIN_PASSWORD=choose-a-long-password
# Optional independent signing secret. Changing it expires all sessions.
SESSION_SECRET=choose-a-long-random-secret

# Contract email is OFF until the sender and credentials have been verified.
CONTRACT_MAIL_ENABLED=false
# Choose resend OR smtp; CONTRACT_MAIL_FROM must be a plain email address.
CONTRACT_MAIL_PROVIDER=resend
CONTRACT_MAIL_FROM=
RESEND_API_KEY=
# SMTP alternative (465 = TLS, 587 = required STARTTLS)
SMTP_HOST=smtp.mail.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
